# ============================================================
# box.mesh — прямоугольный ящик 1×1×1
# Основание на Y=0, центр по X и Z
# ============================================================
#
# Формат:
#   v x y z        вершина
#   f i1 i2 i3     треугольник (индексы с 0, обход CCW снаружи)
#
# Нормали вычисляются движком автоматически.
# ============================================================

# 8 вершин
v -0.5  0.0 -0.5
v  0.5  0.0 -0.5
v  0.5  0.0  0.5
v -0.5  0.0  0.5
v -0.5  1.0 -0.5
v  0.5  1.0 -0.5
v  0.5  1.0  0.5
v -0.5  1.0  0.5

# перед (+Z)
f 3 2 6
f 3 6 7

# зад (-Z)
f 1 0 4
f 1 4 5

# лево (-X)
f 0 3 7
f 0 7 4

# право (+X)
f 2 1 5
f 2 5 6

# верх (+Y)
f 7 6 5
f 7 5 4

# низ (-Y)
f 0 1 2
f 0 2 3
